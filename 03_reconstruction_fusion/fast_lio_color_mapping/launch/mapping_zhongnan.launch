<launch>
  <!-- Launch file for velodyne16 VLP-16 LiDAR -->

    <arg name="rviz" default="false" />
    <arg name="rosbag_path" default="/path/to/rosbag" />
    <arg name="reconstruction_path" default="/path/to/reconstruction/folder" />

    <rosparam command="load" file="$(find fast_lio_color_mapping)/config/zhongnan.yaml" />

    <param name="feature_extract_enable" type="bool" value="0"/>
    <param name="point_filter_num" type="int" value="1"/>
    <param name="max_iteration" type="int" value="200" />
    <param name="filter_size_surf" type="double" value="0.02" />
    <param name="filter_size_map" type="double" value="0.02" />
    <param name="cube_side_length" type="double" value="1000" />
    <param name="runtime_pos_log_enable" type="bool" value="0" />
    <param name="save_result_path" type="string" value="$(arg reconstruction_path)" /> 
    <node pkg="fast_lio_color_mapping" type="fastlio_mapping" name="laserMapping" output="screen" /> 
    
    <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio_color_mapping)/rviz_cfg/loam_livox.rviz" />
    </group> 

    <group if="$(eval arg('rosbag_path') != '')">
      <node pkg="rosbag" type="play" name="player" output="screen" args="-r 0.8 --clock $(arg rosbag_path)" />
    </group> 


</launch>
